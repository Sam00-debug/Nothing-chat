end)

local function displayMessage(userName, msg, privateTargetName)
    local displayName = userName
    local speaker = Players:FindFirstChild(userName)

    if speaker then displayName = speaker.DisplayName end
    if Admin[userName:lower()] then displayName = "[Admin] " .. displayName end
    if Staff[userName:lower()] then displayName = "[Staff] " .. displayName end

    local hexColor = getHexColorForUser(userName)
    local prefix = "💬 "
    
    -- Adjust formatting for Private Messages
    if privateTargetName then
        if userName == LocalPlayer.Name then
            prefix = "[🔐To " .. privateTargetName .. "] "
        else
            prefix = "[🔐From " .. userName .. "] "
        end
    end

    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local msgColor = privateTargetName and "#FF9632" or "#FFFF00"
        local formattedText = string.format("<font color='%s'><b>%s%s:</b></font> <font color='%s'><b>%s</b></font>", hexColor, prefix, displayName, msgColor, msg)
        
        local channel = TextChatService.TextChannels:FindFirstChild("RBXSystem")
        if channel then channel:DisplaySystemMessage(formattedText) end
    else
        pcall(function()
            StarterGui:SetCore("ChatMakeSystemMessage", {
                Text = prefix .. displayName .. ": " .. msg,
                Color = privateTargetName and Color3.fromRGB(255, 150, 50) or Color3.fromRGB(255, 255, 0),
                Font = Enum.Font.SourceSansBold,
                FontSize = Enum.FontSize.Size18
            })
        end)
    end
end

