TextBox:GetPropertyChangedSignal("Text"):Connect(function()
    local t = TextBox.Text

    -- Emoji shortcut (ignored on touch screens)
    if string.match(t, "!e$") then
        TextBox.Text = string.sub(t, 1, -3)
        if not UserInputService.TouchEnabled then
            EmojiFrame.Visible = not EmojiFrame.Visible
        end
        return
    end

    -- Quick Private Chat Setup (now with partial matching)
    local pMatch = string.match(t, "^!p%s+(%w+)%s+$")
    if pMatch then
        TextBox.Text = ""
        setPrivateTarget(pMatch)
    end
end)

local function sendPrivateMessage()
    local text = TextBox.Text
    if text == "" or not text then return end

    local lowerText = string.lower(string.gsub(text, "%s+", ""))
    TextBox.Text = ""

    if lowerText == "!server" then
        chatMode = "server"
        displayMessage("System", "Chat mode switched to SERVER only.", nil)
        return
    elseif lowerText == "!global" then
        chatMode = "global"
        displayMessage("System", "Chat mode switched to GLOBAL.", nil)
        return
    end

    -- Join Command (with partial matching)
    local joinMatch = string.match(text, "^!join%s+(%w+)")
    if joinMatch then
        local matchedName = getFullUsername(joinMatch) or joinMatch
        local loc = playerLocations[matchedName]
        
        if loc and loc.placeId and loc.jobId then
            displayMessage("System", "Attempting to join " .. matchedName .. "...", nil)
            TeleportService:TeleportToPlaceInstance(loc.placeId, loc.jobId, LocalPlayer)
        else
            displayMessage("System", "Location for " .. matchedName .. " is unknown.", nil)
        end
        return
    end

    TextBox.PlaceholderText = " Sending..."
    task.spawn(function()
        local payloadObj = {
            user = LocalPlayer.Name,
            msg = text,
            placeId = game.PlaceId,
            jobId = game.JobId
        }
        
        if privateTarget then payloadObj.target = privateTarget end
        local payload = HttpService:JSONEncode(payloadObj)
        
        local success, res = pcall(function()
            return req({
                Url = SERVER_URL .. "/send",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                Body = payload
            })
        end)
        
        if success and res.StatusCode == 200 then
            TextBox.PlaceholderText = " Type message..."
        else
            TextBox.PlaceholderText = " Failed! Server asleep?"
            task.wait(2)
            TextBox.PlaceholderText = " Type message..."
        end
    end)
end

TextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then sendPrivateMessage() end
end)

-- ==========================================
-- LOGIC: RECEIVING MESSAGES (POLLING)
-- ==========================================
local function pollMessages()
    -- Lowered wait time to 0.5s for faster message delivery
    while isPolling and task.wait(0.5) do
        local success, res = pcall(function()
            return req({
                Url = SERVER_URL .. "/messages?since=" .. tostring(lastSyncTime),
                Method = "GET", Headers = { ["User-Agent"] = "Roblox/WinInet" }
            })
        end)

        if success and res and res.StatusCode == 200 then
            local data = HttpService:JSONDecode(res.Body)
            for _, m in ipairs(data) do
                if m.time > lastSyncTime then
                    lastSyncTime = m.time
                    
                    if m.placeId and m.jobId then
                        playerLocations[m.user] = { placeId = m.placeId, jobId = m.jobId }
                    end
                    
                    -- Filter out automatic system "Joined" spam
                    if m.hidden or m.msg == "Joined" then continue end
                    
                    if chatMode == "server" and m.jobId ~= game.JobId then continue end
                    
                    if m.target and m.target ~= "" then
                        if m.target == LocalPlayer.Name or m.user == LocalPlayer.Name then
                            displayMessage(m.user, m.msg, m.target)
                        end
                        continue
                    end
                    
                    displayMessage(m.user, m.msg, nil)
                end
            end
        end
    end
end

