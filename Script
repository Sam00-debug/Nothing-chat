local userColors = {
    Color3.fromRGB(255, 89, 89), Color3.fromRGB(89, 255, 89), Color3.fromRGB(89, 172, 255),
    Color3.fromRGB(255, 89, 255), Color3.fromRGB(255, 172, 89), Color3.fromRGB(89, 255, 255), Color3.fromRGB(172, 89, 255)
}

local function getHexColorForUser(username)
    local value = 0
    for i = 1, #username do value = value + string.byte(username, i) end
    local color = userColors[(value % #userColors) + 1]
    return string.format("#%02X%02X%02X", color.R * 255, color.G * 255, color.B * 255)
end

-- Tries to find a full username from a partial string
local function getFullUsername(partialName)
    partialName = string.lower(partialName)
    
    -- Check players in the current game
    for _, p in ipairs(Players:GetPlayers()) do
        if string.sub(string.lower(p.Name), 1, #partialName) == partialName or string.sub(string.lower(p.DisplayName), 1, #partialName) == partialName then
            return p.Name
        end
    end
    
    -- Check cached remote players
    for name, _ in pairs(playerLocations) do
        if string.sub(string.lower(name), 1, #partialName) == partialName then
            return name
        end
    end
    
    return nil -- Return nil if no match found
end

-- Function to handle private chat targeting UI updates
local function setPrivateTarget(username)
    if username then
        local matchedName = getFullUsername(username) or username -- Fallbacks to what they typed if not found
        privateTarget = matchedName
        PrivateTag.Text = " [🔐To " .. matchedName .. "] "
        local tagWidth = TextService:GetTextSize(PrivateTag.Text, 12, Enum.Font.GothamBold, Vector2.new(1000, 30)).X + 10
        PrivateTag.Size = UDim2.new(0, tagWidth, 1, -6)
        PrivateTag.Visible = true
        UIPadding.PaddingLeft = UDim.new(0, tagWidth + 10)
    else
        privateTarget = nil
        PrivateTag.Visible = false
        UIPadding.PaddingLeft = UDim.new(0, 5)
    end
end

-- Clear private chat on tag click
PrivateTag.MouseButton1Click:Connect(function()
